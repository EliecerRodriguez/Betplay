# ── Copia este archivo como .env y completa los valores ──────────────────────
# NUNCA subas .env a git. Está en .gitignore por defecto.

# ── Base de datos (Neon / PostgreSQL) ────────────────────────────────────────
# Neon: PostgreSQL serverless. Crea la conexión en Dashboard → Connect.
# La cadena DATABASE_URL tiene precedencia sobre los campos individuales.
DB_HOST=ep-xxxxxxxx-xxxx.us-east-2.aws.neon.tech
DB_PORT=5432
DB_NAME=neondb
DB_USER=neondb_owner
DB_PASSWORD=tu_password

# URL completa (recomendada — reemplaza la de Supabase)
DATABASE_URL=postgresql://neondb_owner:tu_password@ep-xxxxxxxx-xxxx.us-east-2.aws.neon.tech:5432/neondb

# ── NBA API ───────────────────────────────────────────────────────────────────
# nba_api no requiere clave. Ajusta estos parámetros si necesitas.
NBA_API_TIMEOUT=30
NBA_API_DELAY=0.6
NBA_SEASON=2025-26

# ── The Odds API ──────────────────────────────────────────────────────────────
# Regístrate gratis en: https://the-odds-api.com
# Sin clave → el sistema usará cuotas PLACEHOLDER (suficiente para desarrollo).
ODDS_API_KEY=
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4
ODDS_SPORT=basketball_nba
ODDS_REGIONS=us
ODDS_MARKETS=h2h

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs

MODEL_VERSION=v11
MODEL_TYPE=xgboost
